@article{WadaKentaro2017Pvhr,
abstract = {The reliability of picking task for various objects in clutter, as measured on the Amazon Picking Challenge, is far from the expectations of automation companies. Even if the best-performed team, who run object detection before picking the object, had picked a wrong object in the competition. In this paper, we propose a practical method to compose a highly reliable picking system with verification-based approach to reduce the rate of wrong picking and raise the reliability of picking ordered objects. In our approach, which we call pick-and-verify, the robot recognizes object twice: in clutter scene to detect the target and in hand after picking an object with less time loss and rise of reliability of picking the target. For grasping the detected object we do not assume its pose and it is actually the target object, instead, we adopt vision-based grasp planning for vacuum gripper with sensed 3-D point cloud. With the presented approach, the reliability of picking target objects raised 50%, and the score in the APC2015 competition has been improved to be close to the best-performed team by picking 9 out of 12 objects in 10 min with the same hardware in our previous system.},
author = {Wada, Kentaro and Sugiura, Makoto and Yanokura, Iori and Inagaki, Yuto and Okada, Kei and Inaba, Masayuki},
address = {ABINGDON},
copyright = {2017 Taylor & Francis and The Robotics Society of Japan 2017},
issn = {0169-1864},
journal = {Advanced robotics},
keywords = {Competition ;  Hardware ;  Reliability ;  Robotics ;  Robots ;  Technology},
language = {eng},
number = {6},
pages = {311-321},
publisher = {Taylor & Francis},
title = {Pick-and-verify: verification-based highly reliable picking system for various target objects in clutter},
volume = {31},
year = {2017},
}
@article{AnwarMuddasar2019Mapo,
abstract = {Purpose
This paper aims to present a soft closed-chain modular gripper for robotic pick-and-place applications. The proposed biomimetic gripper design is inspired by the Fin Ray effect, derived from fish fins physiology. It is composed of three axisymmetric fingers, actuated with a single actuator. Each finger has a modular under-actuated closed-chain structure. The finger structure is compliant in contact normal direction, with stiff crossbeams reorienting to help the finger structure conform around objects.
Design/methodology/approach
Starting with the design and development of the proposed gripper, a consequent mathematical representation consisting of closed-chain forward and inverse kinematics is detailed. The proposed mathematical framework is validated through the finite element modeling simulations. Additionally, a set of experiments was conducted to compare the simulated and prototype finger trajectories, as well as to assess qualitative grasping ability.
Findings
Key Findings are the presented mathematical model for closed-loop chain mechanisms, as well as design and optimization guidelines to develop controlled closed-chain grippers.
Research limitations/implications
The proposed methodology and mathematical model could be taken as a fundamental modular base block to explore similar distributed degrees of freedom (DOF) closed-chain manipulators and grippers. The enhanced kinematic model contributes to optimized dynamics and control of soft closed-chain grasping mechanisms.
Practical implications
The approach is aimed to improve the development of soft grippers that are required to grasp complex objects found in human–robot cooperation and collaborative robot (cobot) applications.
Originality/value
The proposed closed-chain mathematical framework is based on distributed DOFs instead of the conventional lumped joint approach. This is to better optimize and understand the kinematics of soft robotic mechanisms.},
author = {Anwar, Muddasar and Khawli, Toufik Al and Hussain, Irfan and Gan, Dongming and Renda, Federico},
address = {Leeds},
copyright = {Emerald Publishing Limited},
issn = {0143-991X},
journal = {Industrial robot},
keywords = {Actuators ;  Automation ;  Biomechanics ;  Biomimetics ;  Chains ;  Compliance ;  Computer simulation ;  Conformity ;  Design ;  Engineering ;  Fingers ;  Finite element method ;  Kinematics ;  Mathematical analysis ;  Mathematical models ;  Mechanical properties ;  Modular construction ;  Optimal designs (Statistics) ;  Pneumatics ;  Research ;  Robotics ;  Robots ;  Technology},
language = {eng},
number = {1},
pages = {135-145},
publisher = {Emerald Publishing Limited},
title = {Modeling and prototyping of a soft closed-chain modular gripper},
volume = {46},
year = {2019},
}

@article{ItoTakatoshi2022Vfcc,
abstract = {A vision feedback control method is presented to automate the pick-and-place of a single-nozzle capillary force gripper that manipulates millimetre-sized objects via a water droplet. Dual cameras and OpenCV-based contour detection compute the nozzle position, achieving placement accuracy of about 44 micrometres at a 99 percent success rate. The approach targets flexible electronics, MEMS, soft robotics and biomedical micro-assembly.},
author = {Ito, Takatoshi and Fukuchi, Eri and Tanaka, Kenta and Nishiyama, Yuki and Watanabe, Naoto and Fuchiwaki, Ohmi},
doi = {10.3390/mi13081270},
issn = {2072-666X},
journal = {Micromachines},
language = {eng},
number = {8},
pages = {1270},
publisher = {MDPI},
title = {Vision Feedback Control for the Automation of the Pick-and-Place of a Capillary Force Gripper},
volume = {13},
year = {2022},
}

@inproceedings{ChenChong2013Fcrg,
abstract = {A force-controlled robot gripper with a flexible (compliant) finger joint is proposed for delicate assembly tasks. Closed-loop grasping-force control is motivated by the need to handle delicate electronic parts, where excessive force could permanently deform or damage the components. The compliant joint and force feedback allow the gripper to adapt to odd-shaped parts during automatic electronics assembly.},
author = {Chen, Chin-Hsing and Chong, Wei},
booktitle = {2013 13th International Conference on Control, Automation and Systems (ICCAS)},
note = {IEEE Xplore document 6704049; verify page range against IEEE Xplore before final submission},
publisher = {IEEE},
title = {Force controlled robot gripper with flexible joint for delicate assembly task},
year = {2013},
}

@article{BackDrivable2022Lfaa,
abstract = {A miniature, compact and modular back-drivable linear series elastic force actuator is developed for adaptive robotic grasping. Because the actuator is back-drivable, external grasping force at the fingertip is reflected back to and sensed by the actuator, so an underactuated finger can achieve adaptive grasp-force control without a dedicated fingertip force sensor.},
doi = {10.1007/s12206-022-0739-9},
journal = {Journal of Mechanical Science and Technology},
publisher = {Springer},
title = {A back-drivable linear force actuator for adaptive grasping},
year = {2022},
}

@misc{Bhatia2019Qdd,
abstract = {Quasi-direct-drive (QDD) actuation uses high torque-density motors with ultra-low gear ratios to deliver high torque with minimal inertia and friction. The resulting back-drivable transmission gives passive compliance and allows external forces at the output to be estimated by measuring motor current, enabling low-cost compliant manipulation without external force sensors.},
author = {Bhatia, Ankur and Johnson, Aaron M. and Mason, Matthew T.},
eprint = {1904.03815},
archivePrefix = {arXiv},
primaryClass = {cs.RO},
title = {Direct Drive Hands: Force-Motion Transparency in Gripper Design (Quasi-Direct Drive for Low-Cost Compliant Robotic Manipulation)},
year = {2019},
}

@misc{Salmon2024Magpie,
abstract = {MAGPIE is an open-source force-controlled robotic gripper with integrated 3D perception. The servo-driven gripper provides closed-loop grasping-force control of up to 32 N adjustable in steps of 0.08 N using motor-current feedback, and has been validated on assembly tasks, demonstrating object-in-hand detection and delicate force regulation.},
author = {Salmon, Streck and Correll, Nikolaus},
eprint = {2402.06018},
archivePrefix = {arXiv},
primaryClass = {cs.RO},
title = {A versatile robotic hand with 3D perception, force sensing for autonomous manipulation},
year = {2024},
}


